{
  "installCommand": "cd backend && npm install && cd ../frontend && npm install --include=dev",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|uploads/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/attendance",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/care",
      "schedule": "40 2 * * *"
    },
    {
      "path": "/api/cron/safety",
      "schedule": "15 22 * * *"
    },
    {
      "path": "/api/cron/comms",
      "schedule": "5 2 * * *"
    },
    {
      "path": "/api/cron/theme",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/cron/sales",
      "schedule": "50 3 * * *"
    },
    {
      "path": "/api/cron/training",
      "schedule": "35 4 * * *"
    }
  ]
}
