PORT=5000
# PostgreSQL connection string (Neon / Vercel Postgres). For a local file database leave empty and set PGLITE_DIR=./.data/pg
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

NODE_ENV=development

# Email Configuration (for notifications)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Default school time zone for attendance period windows (IANA name)
DEFAULT_TIMEZONE=Asia/Karachi

# ── SaaS platform owner (Super Admin) – created automatically on first boot ──
SUPERADMIN_NAME=Platform Owner
SUPERADMIN_EMAIL=owner@yourdomain.com
SUPERADMIN_PASSWORD=ChangeMe@12345
# Set to true once to re-apply the password above (recovery), then remove it
SUPERADMIN_FORCE_RESET=false

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Weekly school backups: Vercel Cron sends this as 'Authorization: Bearer <value>' (set any long random string)
CRON_SECRET=
